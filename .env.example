# Copy to .env and fill in your own values. Never commit .env.

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatcrm
DB_USER=
DB_PASSWORD=

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Flask session signing key (any long random string)
FLASK_SECRET_KEY=

# Credentials used by the manual integration scripts in tests/
CHATCRM_TEST_USER=
CHATCRM_TEST_PASSWORD=
